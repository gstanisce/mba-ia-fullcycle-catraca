{
  "name": "catraca",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "tsx src/main.ts",
    "migrate": "tsx src/scripts/migrate.ts",
    "seed": "tsx src/scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gates:inner": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/formbody": "9.0.2",
    "fastify": "5.12.8",
    "pg": "8.23.1",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@types/node": "24.19.3",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
